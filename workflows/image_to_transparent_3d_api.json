{
  "_node_ids": {
    "load": "1",
    "text": "6",
    "noise": "8",
    "idol": "13"
  },
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "Any image"},
    "inputs": {"image": "input.png"}
  },
  "2": {
    "class_type": "UnetLoaderGGUF",
    "_meta": {"title": "Qwen Image 2.1 Turbo (GGUF Q5_K_M)"},
    "inputs": {"unet_name": "qwen-image-2.1-turbo-Q5_K_M.gguf"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen3-VL 8B text encoder (int8)"},
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "Qwen Image 2.1 VAE"},
    "inputs": {"vae_name": "qwen_image_2.1_vae_bf16.safetensors"}
  },
  "5": {
    "class_type": "QwenImage21Cache",
    "_meta": {"title": "Qwen Image 2.1 cache"},
    "inputs": {"model": ["2", 0], "device": "auto", "dtype": "default"}
  },
  "6": {
    "class_type": "TextEncodeQwenImage21",
    "_meta": {"title": "Make it transparent (image edit)"},
    "inputs": {
      "clip": ["3", 0],
      "prompt": "This is an RGBA format image with transparency. Keep the subject from the reference image exactly as it is - the same shape, proportions, materials, colours and viewpoint - and remove the background completely. Nothing else is in the frame. The image has an alpha channel and a transparent background.",
      "negative_prompt": "",
      "vae": ["4", 0],
      "resolution": 1024,
      "images.image_1": ["1", 0]
    }
  },
  "7": {
    "class_type": "CFGGuider",
    "_meta": {"title": "CFG 1 (Turbo)"},
    "inputs": {"model": ["5", 0], "positive": ["6", 0], "negative": ["6", 1], "cfg": 1.0}
  },
  "8": {
    "class_type": "RandomNoise",
    "_meta": {"title": "Noise / seed"},
    "inputs": {"noise_seed": 42}
  },
  "9": {
    "class_type": "KSamplerSelect",
    "_meta": {"title": "Euler"},
    "inputs": {"sampler_name": "euler"}
  },
  "10": {
    "class_type": "ManualSigmas",
    "_meta": {"title": "Turbo 8-step sigmas"},
    "inputs": {"sigmas": "1.0, 0.978453, 0.95418, 0.926626, 0.89508, 0.845148, 0.704534, 0.414568, 0"}
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "Sample (edit)"},
    "inputs": {
      "noise": ["8", 0],
      "guider": ["7", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 2]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode (RGBA)"},
    "inputs": {"samples": ["11", 0], "vae": ["4", 0]}
  },
  "13": {
    "class_type": "IdolImageTo3D",
    "_meta": {"title": "Idol — transparent image to 3D"},
    "inputs": {
      "image": ["12", 0],
      "mode": "synthetic",
      "steps": 50,
      "num_gaussians": 262144,
      "seed": 42,
      "filename_prefix": "3d/edit",
      "weights": "C:\\idol\\idol-bf16",
      "dtype": "bf16",
      "keep_loaded": false
    }
  },
  "14": {
    "class_type": "SaveImage",
    "_meta": {"title": "Transparent PNG (RGBA)"},
    "inputs": {"images": ["12", 0], "filename_prefix": "idol3d/edit_transparent"}
  }
}
